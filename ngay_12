}
void sap_xep(int a[],int n){
	int i;int j;
	for (i=0;i<n-1;i++){
		for (j=i+1;j<n;j++){
		if (a[i]>a[j]){
			int change =a[i];
			a[i]=a[j];
			a[j]=change;
		}	
		}
	}
	for (i=0;i<n;i++){
		printf ("%d ",a[i]);
	}
}
