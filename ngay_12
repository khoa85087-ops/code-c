}
int max_arr(int a[],int n){
	int i;
	int max_a=a[0];
	for (i=1;i<n;i++){
		if (max_a<a[i]){
			max_a=a[i];
		}
	}
	return max_a;
}
int min_arr(int a[],int n){
	int i;
	int min_a=a[0];
	for (i=1;i<n;i++){
		if (min_a>a[i]){
			min_a=a[i];
		}
	}
	return min_a;
}
int tong_arr(int a[],int n){
	int i; int s=0;
	for (i=0;i<n;i++){
