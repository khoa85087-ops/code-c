#include <stdio.h>
// cứ làm nhu thường nhớ đổi thành *a lúc viết hàm con là được 
void changeArray(int *a, int n);

int main() {
    int a[3] = {1, 2, 3};

    changeArray(a, 3);

    for(int i = 0; i < 3; i++) {
        printf("%d ", a[i]);
    }
}

void changeArray(int *a, int n) {
    for(int i = 0; i < n; i++) {
        a[i] = a[i] * 2;
    }
}
